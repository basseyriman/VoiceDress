# VoiceDress — copy to .env.local and fill values
# NEVER commit real secrets.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase client (project: wardrobe-2135e)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=wardrobe-2135e.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=wardrobe-2135e
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=wardrobe-2135e.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server) — required for Stripe webhooks + paid API auth
# Prefer one JSON secret, or the three discrete fields below.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN...","client_email":"..."}
FIREBASE_PROJECT_ID=wardrobe-2135e
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Local only: skip real Admin verification (never enable in production)
# ALLOW_INSECURE_API=true

# Founder / free access (comma-separated). Server-only — do NOT use NEXT_PUBLIC_.
# ENTITLEMENT_BYPASS_UIDS=yourFirebaseUid
# ENTITLEMENT_BYPASS_EMAILS=you@example.com

# Stripe — create GBP prices: £19/month and £149/year, then paste Price IDs
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_MONTHLY=price_...
STRIPE_PRICE_ID_YEARLY=price_...

# Voice
ASSEMBLYAI_API_KEY=
# Optional Gradium TTS
GRADIUM_API_KEY=

# LLM (occasion intelligence, app-aware voice, photo ingest)
OPENAI_API_KEY=
# or AI_GATEWAY_API_KEY=

# Shopify OAuth + order sync
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_orders,read_products

# Photoreal try-on — FASHN Try-On Max (preferred)
# Get a key at https://app.fashn.ai / https://fashn.ai/products/api
FASHN_API_KEY=
# Optional: fast | balanced | quality (default quality). 1k | 2k | 4k (default 2k for clearer HD)
# FASHN_GENERATION_MODE=quality
# FASHN_RESOLUTION=2k

# Optional: override finish provider for shoes/glasses/watch
# Default: fashn (Try-On Max) when FASHN_API_KEY is set, else kontext
# TRYON_FINISH_PROVIDER=fashn
# TRYON_FINISH_PROVIDER=kontext
# TRYON_FINISH_PROVIDER=openai

# PostHog (product analytics — EU cloud if you signed up on eu.posthog.com)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
